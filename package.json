{
    "name": "prisma-generic-better-sqlite3",
    "version": "0.0.1",
    "description": "A better-sqlite3 database driver for Prisma that accepts a user defined Database.",
    "keywords": [
        "prisma",
        "better-sqlite3",
        "driver adapter",
        "sqlite",
        "sqlite3",
        "orm"
    ],
    "homepage": "https://github.com/electrovir/prisma-generic-better-sqlite3",
    "bugs": {
        "url": "https://github.com/electrovir/prisma-generic-better-sqlite3/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/prisma-generic-better-sqlite3.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "prisma generate --no-hints && virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "prisma generate && virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@prisma/driver-adapter-utils": "^6.7.0",
        "@types/better-sqlite3": "^7.6.13",
        "async-mutex": "^0.5.0",
        "better-sqlite3": "^11.10.0"
    },
    "devDependencies": {
        "@augment-vir/assert": "^31.17.1",
        "@augment-vir/test": "^31.17.1",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.26.0",
        "@prisma/client": "^6.7.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "better-sqlite3-multiple-ciphers": "^11.9.1",
        "cspell": "^9.0.1",
        "dependency-cruiser": "^16.10.2",
        "esbuild": "^0.25.4",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsdoc": "^50.6.11",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.11",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.5",
        "prisma": "^6.7.0",
        "typedoc": "^0.28.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "virmator": "^13.15.1"
    },
    "engines": {
        "node": ">=22"
    }
}
